{
  "manifest_version": 3,
  "name": "SuperProfile CRM — lead lookup",
  "version": "1.6.0",
  "description": "On Instagram profiles, YouTube channels and videos, and Skool communities: shows whether this creator is a lead in the SuperProfile CRM, what stage they are at, and lets you add a missing email inline.",
  "permissions": [
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "https://superprofile-leadgen.superprofile-crm.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "SuperProfile CRM lookup",
    "default_popup": "options.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*",
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://www.skool.com/*",
        "https://skool.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
